# Cloud Clipboard 环境变量配置示例
# 复制此文件为 .env 并修改其中的值

# ========== 基础配置 ==========
LISTEN_PORT=9501
LISTEN_IP=0.0.0.0
PREFIX=

# ========== 认证配置 ==========
# 设置为 true 会自动生成随机密码
# 设置为具体字符串则使用该字符串作为密码
AUTH_PASSWORD=your-secure-password-here

# ========== 文件配置 ==========
# 文件过期时间（秒），默认 1 小时
FILE_EXPIRE=3600

# 文件大小限制（字节），默认 100MB
FILE_LIMIT=104857600

# 文本内容限制（字符），默认 4KB
TEXT_LIMIT=4096

# ========== 消息配置 ==========
# 历史消息数量，默认 100
MESSAGE_NUM=100

# ========== 房间配置 ==========
# 启用房间列表功能
ROOM_LIST=false

# 房间清理间隔（秒）
ROOM_CLEANUP=3600

# ========== 安全配置 ==========
# CORS 允许的来源（多个用逗号分隔）
# 示例: https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 速率限制：每 IP 每秒请求数（0=禁用）
RATE_LIMIT=100

# 速率限制：突发请求数
RATE_LIMIT_BURST=200

# ========== SSL 配置（可选） ==========
# 使用 mkcert 自动生成证书
# 设置域名或 IP 地址
#MKCERT_DOMAIN_OR_IP=your-domain.com

# 手动指定证书路径（覆盖 mkcert）
#MANUAL_KEY_PATH=/path/to/key.pem
#MANUAL_CERT_PATH=/path/to/cert.pem
